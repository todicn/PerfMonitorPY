{
  "rules": [
    "Always use conventional commits",
    "Use semantic versioning",
    "Follow C# coding conventions and naming standards",
    "Write comprehensive XML documentation",
    "Include nullable reference types where appropriate",
    "Test all new features and bug fixes using xUnit",
    "Use async/await patterns for I/O operations",
    "Follow SOLID principles and clean code practices"
  ],
  "git": {
    "defaultBranch": "main",
    "remoteOrigin": "https://github.com/todicn/PerfMonitorPY.git",
    "branches": {
      "main": "Production branch",
      "dev-1": "Development branch for C# conversion"
    }
  },
  "dotnet": {
    "version": "6.0+",
    "targetFramework": "net6.0",
    "formatting": "dotnet format",
    "linting": "dotnet analyze",
    "testing": "xunit",
    "nullable": "enable",
    "langVersion": "latest"
  },
  "csharp": {
    "conventions": {
      "namingStyle": "PascalCase",
      "privateFieldPrefix": "_",
      "interfaces": "IPrefix",
      "asyncSuffix": "Async"
    },
    "features": {
      "nullableReferenceTypes": true,
      "recordTypes": true,
      "patternMatching": true,
      "asyncStreams": true
    }
  }
} 