{
    "name": "PerfMonitorPY Development Environment",
    "description": "Python performance monitoring system development environment",
    "python": {
        "version": "3.6+",
        "interpreter": "python",
        "virtualenv": {
            "enabled": true,
            "path": "./venv"
        },
        "packages": {
            "development": [
                "black",
                "flake8",
                "pytest",
                "pytest-cov",
                "mypy"
            ],
            "runtime": []
        }
    },
    "editor": {
        "formatOnSave": true,
        "formatOnType": false,
        "rulers": [88],
        "tabSize": 4,
        "insertSpaces": true,
        "detectIndentation": true
    },
    "linting": {
        "enabled": true,
        "providers": {
            "flake8": {
                "enabled": true,
                "args": ["--max-line-length=88", "--extend-ignore=E203,W503"]
            },
            "mypy": {
                "enabled": true,
                "args": ["--ignore-missing-imports", "--strict-optional"]
            }
        }
    },
    "formatting": {
        "provider": "black",
        "black": {
            "args": ["--line-length=88"]
        }
    },
    "testing": {
        "framework": "pytest",
        "autoDiscover": true,
        "defaultArgs": ["-v", "--tb=short"],
        "coverage": {
            "enabled": true,
            "reportFormats": ["html", "term"]
        }
    },
    "git": {
        "hooks": {
            "pre-commit": {
                "enabled": true,
                "commands": [
                    "black --check .",
                    "flake8 .",
                    "pytest --tb=short"
                ]
            }
        },
        "conventionalCommits": true
    },
    "workspace": {
        "folders": [
            {
                "name": "PerfMonitorPY",
                "path": "."
            }
        ],
        "extensions": {
            "recommendations": [
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.flake8",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "terminal": {
        "defaultProfile": "PowerShell",
        "profiles": {
            "PowerShell": {
                "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
            }
        }
    },
    "tasks": {
        "test": {
            "command": "pytest",
            "args": ["-v", "--cov=performance_monitor"],
            "group": "test"
        },
        "format": {
            "command": "black",
            "args": ["."],
            "group": "build"
        },
        "lint": {
            "command": "flake8",
            "args": ["."],
            "group": "build"
        },
        "install-dev": {
            "command": "pip",
            "args": ["install", "-r", "requirements.txt"],
            "group": "build"
        }
    },
    "debugConfiguration": {
        "python": {
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    }
} 