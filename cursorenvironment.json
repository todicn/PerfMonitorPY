{
    "name": "PerfMonitorCS Development Environment",
    "description": "C# performance monitoring system development environment",
    "dotnet": {
        "sdk": "6.0+",
        "targetFramework": "net6.0",
        "runtime": "dotnet",
        "packages": {
            "core": [
                "System.Text.Json"
            ],
            "testing": [
                "xunit",
                "xunit.runner.visualstudio",
                "Microsoft.NET.Test.Sdk"
            ],
            "development": [
                "Microsoft.CodeAnalysis.Analyzers",
                "StyleCop.Analyzers"
            ]
        }
    },
    "editor": {
        "formatOnSave": true,
        "formatOnType": false,
        "rulers": [120],
        "tabSize": 4,
        "insertSpaces": true,
        "detectIndentation": true
    },
    "linting": {
        "enabled": true,
        "providers": {
            "dotnet": {
                "enabled": true,
                "analyzers": ["Microsoft.CodeAnalysis.CSharp.CodeStyle", "StyleCop.Analyzers"]
            },
            "editorconfig": {
                "enabled": true
            }
        }
    },
    "formatting": {
        "provider": "dotnet",
        "dotnet": {
            "style": "Microsoft",
            "args": ["--verbosity", "diagnostic"]
        }
    },
    "testing": {
        "framework": "xunit",
        "autoDiscover": true,
        "defaultArgs": ["--logger", "console"],
        "coverage": {
            "enabled": true,
            "reportFormats": ["html", "console"]
        }
    },
    "git": {
        "hooks": {
            "pre-commit": {
                "enabled": true,
                "commands": [
                    "dotnet format --verify-no-changes",
                    "dotnet build --no-restore",
                    "dotnet test --no-restore --no-build"
                ]
            }
        },
        "conventionalCommits": true
    },
    "workspace": {
        "folders": [
            {
                "name": "PerfMonitorCS",
                "path": "."
            }
        ],
        "extensions": {
            "recommendations": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.vscode-dotnet-runtime",
                "ms-vscode.vscode-json"
            ]
        }
    },
    "terminal": {
        "defaultProfile": "PowerShell",
        "profiles": {
            "PowerShell": {
                "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
            }
        }
    },
    "tasks": {
        "build": {
            "command": "dotnet",
            "args": ["build"],
            "group": "build"
        },
        "test": {
            "command": "dotnet",
            "args": ["test", "--logger", "console"],
            "group": "test"
        },
        "run-examples": {
            "command": "dotnet",
            "args": ["run", "--project", "PerfMonitorCS.Examples"],
            "group": "build"
        },
        "format": {
            "command": "dotnet",
            "args": ["format"],
            "group": "build"
        },
        "clean": {
            "command": "dotnet",
            "args": ["clean"],
            "group": "build"
        },
        "restore": {
            "command": "dotnet",
            "args": ["restore"],
            "group": "build"
        }
    },
    "debugConfiguration": {
        "csharp": {
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/PerfMonitorCS.Examples/bin/Debug/net6.0/PerfMonitorCS.Examples.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    }
} 